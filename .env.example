# Copy to .env and edit. Every value here is optional — the app runs with an
# empty .env (or no .env at all).

# ── Server ─────────────────────────────────────────────────────────────────
# Port to listen on. If busy, the next free port up to PORT+19 is used.
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────
# Local SQLite file, relative to the project root. The default snapshot is
# included in the repository; a missing file is created and seeded on start.
# A `file:` prefix is accepted too.
DATABASE_URL=./data/app.db

# ── Local user ─────────────────────────────────────────────────────────────
# There is no sign-in when running locally: every request is attributed to a
# single auto-provisioned user. These control how it appears in the UI.
LOCAL_USER_NAME=Local User
LOCAL_USER_EMAIL=local@localhost

# ── AI code review (optional) ──────────────────────────────────────────────
# Powers the "Analyze" button. Without a key the button reports that the
# feature is not configured; everything else works.
# Anthropic is used when ANTHROPIC_API_KEY is set, otherwise OpenAI.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Any OpenAI-compatible endpoint works here (OpenAI, Ollama, LM Studio, ...).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
